{
  "name": "afghan-cultural-platform",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "echo \"Use pnpm dev:web or pnpm dev:api. A combined dev command is not configured yet.\"",
    "build": "echo \"Use pnpm build:web or pnpm build:api. A combined build command is not configured yet.\"",
    "lint": "pnpm check",
    "lint:fix": "pnpm check:write",
    "typecheck": "pnpm typecheck:web",
    "test": "pnpm test:web",
    "dev:web": "pnpm --filter @afghan-culture/web dev",
    "build:web": "pnpm --filter @afghan-culture/web build",
    "typecheck:web": "pnpm --filter @afghan-culture/web typecheck",
    "test:web": "pnpm --filter @afghan-culture/web test",
    "dev:api": "pnpm --filter @afghan-culture/api dev",
    "build:api": "pnpm --filter @afghan-culture/api build",
    "typecheck:api": "pnpm --filter @afghan-culture/api typecheck",
    "test:api": "pnpm --filter @afghan-culture/api test",
    "prisma:generate": "pnpm --filter @afghan-culture/api prisma:generate",
    "prisma:format": "pnpm --filter @afghan-culture/api prisma:format",
    "prisma:validate": "pnpm --filter @afghan-culture/api prisma:validate",
    "prisma:studio": "pnpm --filter @afghan-culture/api prisma:studio",
    "prisma:seed": "pnpm --filter @afghan-culture/api prisma:seed",
    "check": "biome check .",
    "check:write": "biome check . --write",
    "format": "biome format . --write",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5"
  }
}
